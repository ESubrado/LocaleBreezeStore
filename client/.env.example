# Public Supabase values are compiled into the browser bundle during the Docker build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# AI settings stay server-side. Use one of the providers below.
# Ollama: the base URL must not include /api/chat.
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen2.5-coder:7b

# Cloudflare Workers AI: replace the account ID and use a Workers AI API token.
# AI_PROVIDER=cloudflare-workers-ai
# AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
# AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# AI_API_KEY=your-cloudflare-workers-ai-api-token

# OpenAI-compatible: the base URL must end with /v1.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.example.com/v1
# AI_MODEL=your-model-id
# AI_API_KEY=your_server_only_api_key
