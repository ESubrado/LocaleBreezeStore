language = "javascript"
modules = ["nodejs-20"]
entrypoint = "src/app/page.tsx"
run = "corepack enable && pnpm dev -- --hostname 0.0.0.0"
onBoot = "corepack enable && pnpm install --frozen-lockfile"
hidden = ["node_modules", ".next"]

[gitHubImport]
requiredFiles = [".replit", "package.json", "pnpm-lock.yaml", "next.config.ts"]

[packager]
language = "nodejs"
ignoredPaths = ["node_modules", ".next"]

[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

[deployment]
build = "corepack enable && pnpm install --frozen-lockfile && pnpm build"
run = "corepack enable && pnpm start -- --hostname 0.0.0.0"

[[ports]]
localPort = 3000
externalPort = 80
