language = "javascript"
modules = ["nodejs-20"]
entrypoint = "src/app/page.tsx"
run = "npm run dev -- --hostname 0.0.0.0"
onBoot = "npm install"
hidden = ["node_modules", ".next"]

[gitHubImport]
requiredFiles = [".replit", "package.json"]

[packager]
language = "nodejs"
ignoredPaths = ["node_modules", ".next"]

[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

[deployment]
build = "npm ci && npm run build"
run = "npm run start -- --hostname 0.0.0.0"

[[ports]]
localPort = 3000
externalPort = 80
